# Copy to .env.local. Every data source works without keys; only the AI features
# (daily brief, headline translation + tagging) need one.

# AI provider: "gemini" or "anthropic". Optional: guessed from the key if empty.
AI_PROVIDER=
# The provider's API key (Google AI Studio key, or a Claude "sk-ant-..." key).
# GEMINI_API_KEY / GOOGLE_API_KEY / ANTHROPIC_API_KEY are also accepted.
AI_API_KEY=

# Optional model overrides
#   gemini defaults:    brief = gemini-flash-latest, fast = gemini-flash-lite-latest
#                       (gemini-pro-latest is better for the brief but has no free-tier quota)
#   anthropic defaults: brief = claude-sonnet-5-5,  fast = claude-haiku-5-5
# AI_MODEL_BRIEF=
# AI_MODEL_FAST=

# Optional: free CoinGecko "Demo" key. Not needed locally; helps on cloud hosts
# whose shared IPs hit the keyless rate limit.
# COINGECKO_API_KEY=

# DB_PATH=./data/whathappend.db
