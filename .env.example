# Copy to .env.local. Every data source works without keys; only the AI features
# (daily brief, weekly macro note, headline translation + tagging, indicator notes) need one.

# AI provider: "gemini" or "anthropic". Optional: guessed from the key if empty.
AI_PROVIDER=
# The provider's API key (Google AI Studio key, or a Claude "sk-ant-..." key).
# GEMINI_API_KEY / GOOGLE_API_KEY / ANTHROPIC_API_KEY are also accepted.
AI_API_KEY=

# Optional model overrides
#   gemini defaults:    brief = gemini-flash-latest, fast = gemini-flash-lite-latest
#                       (gemini-pro-latest is better for the brief but has no free-tier quota)
#   anthropic defaults: brief = claude-sonnet-5-5,  fast = claude-haiku-5-5
# AI_MODEL_BRIEF=
# AI_MODEL_FAST=

# Optional daily request budgets (lib/ai/budget.ts). Gemini's free tier allows about
# 20 requests a day on the brief model; the brief, the weekly macro note and the
# indicator notes share them. Raise on a paid plan; 0 = unlimited.
# AI_DAILY_LIMIT_BRIEF=20
# AI_DAILY_LIMIT_FAST=

# Optional: free CoinGecko "Demo" key. Not needed locally; helps on cloud hosts
# whose shared IPs hit the keyless rate limit.
# COINGECKO_API_KEY=

# Optional: Telegram alerts sent by the worker (lib/data/alerts.ts, thresholds in config/alerts.ts).
# 1. Create a bot with @BotFather and copy its token.
# 2. Send the bot any message, then open https://api.telegram.org/bot<token>/getUpdates
#    and copy "chat":{"id":...} (a group id starts with -).
# Restart the worker after setting both; the first run sends an "alerts on" message.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# DB_PATH=./data/whathappend.db
